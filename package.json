{
  "name": "codex-hackathon-showcase",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare:data": "node scripts/prepare-data.mjs",
    "dev": "npm run prepare:data && vite --host 0.0.0.0",
    "build": "npm run prepare:data && tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:public-data": "npm run prepare:data && node scripts/assert-public-data.mjs",
    "test:loom-embeds": "npm run prepare:data && node scripts/assert-loom-embeds.mjs",
    "test:team-data": "npm run prepare:data && node scripts/assert-public-team-data.mjs",
    "test:home-content": "node scripts/assert-home-content.mjs",
    "test:submission-overrides": "npm run prepare:data && node scripts/assert-submission-overrides.mjs",
    "test:expandable-descriptions": "node scripts/assert-expandable-descriptions.mjs",
    "test:demo-embeds": "npm run prepare:data && node scripts/assert-demo-embeds.mjs",
    "test:video-loading": "node scripts/assert-video-loading-overlay.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3"
  }
}
